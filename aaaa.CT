tpt_stop = false

local function writeLoop()
    local pointerExpr = '[[[[["GameAssembly.dll"+079DCDC0]+B8]+70]+40]+20]'

    for i, coord in ipairs(coordinates) do
        if tpt_stop then break end

        local realBase = getAddress(pointerExpr)
        if realBase and realBase ~= 0 then
            writeFloat(realBase + 0x108, coord[1]) -- X
            writeFloat(realBase + 0x10C, coord[2]) -- Y
            writeFloat(realBase + 0x110, coord[3]) -- Z
        end
        sleep(300)
    end
end
tpt_stop = false
createThread(writeLoop)
