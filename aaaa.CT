<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry NoScriptTag="1">
      <ID>20723</ID>
      <Description>"自动选择进程（CE可能会崩溃）"</Description>
      <Options moActivateChildrenAsWell="1"/>
      <Color>FF0000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

{$lua}
local processName = "launcher.exe"
local t = createTimer(nil)
t.Interval = 500

t.OnTimer = function(timer)
  local targetPid = getProcessIDFromProcessName(processName)

  if targetPid and targetPid ~= 0 then

    if targetPid == processID then
      timer.setEnabled(false)
      synchronize(function() timer.destroy() end)
      return
    end

    timer.setEnabled(false)
    synchronize(function()
      openProcess(targetPid)
      timer.destroy()
    end)
  end
end
{$asm}

